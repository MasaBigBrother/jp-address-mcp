# ==========================================================
# jp-address-mcp 環境設定テンプレート
# 本番では .env にコピーして値を埋める（.env はgit管理しないこと）
# ==========================================================

# --- 課金モード ---
# free   : 課金しない（PoC/デモ・最初の動作確認はこれ）
# apikey : 前払いクレジット方式（初動の確実回収レール）
# x402   : 機械間自動決済（理想形。ウォレット/facilitator結線後）
PAYMENT_MODE=free
PRICE_PER_CALL=0.004          # 1回あたりの価格(USDC想定 ≒ 0.5円)
PAY_TO_ADDRESS=               # 受取ウォレット/口座識別子(x402時)

# --- AI役員会(上物) ---
ANTHROPIC_API_KEY=            # ここにあなたのAnthropic APIキー
EXEC_MODEL=claude-sonnet-5    # 役員AIに使うモデル(安価なモデルで十分)
MAX_DAILY_LLM_CALLS=3         # コスト上限ガード(監査/計画/社長=3)

# --- 通知(あなたへの日報) ---
# console / file / email / slack
NOTIFY_MODE=file
REPORT_DIR=./reports
# SLACK_WEBHOOK_URL=
# SMTP_HOST= / SMTP_USER= / SMTP_PASS= (email時)

# --- データ堀 ---
MOAT_DIR=./data
